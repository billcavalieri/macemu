#
# SheepShaver guest media and local prefs (WP0). Never commit ROMs or images.
# Keep SheepShaver/src/MacOSX/prefs.os921.template; ignore a filled-in "prefs".
# Local G0 files live under $HOME/Library/Application Support/SheepShaver/os921/
# (setup-os921-prefs.sh). Do not copy a ROM or .toast into this tree.
#
Mac OS ROM
*.smi
*.smi.bin
*.toast
*.dmg
*.iso
*.dsk
*.hfv
*.img
*.cdr
*.hfs
prefs
.sheepshaver_prefs
os921-local/
SheepShaver/src/MacOSX/SDL2.framework

#
# Python
#
__pycache__/
*.py[cod]
*$py.class

